# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 팀 공용 Anthropic 키는 비밀번호 관리자로 공유하고, Console에서 월 사용량 한도를 먼저 건다.

# ---- 백엔드 ----
# fake: 네트워크 없이 동작하는 가짜 모델 (테스트·UI 개발용). anthropic: Claude API 실제 호출.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# 첨삭 모델. 비용 비교용으로 바꿔 가며 실험한다 (claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5).
LLM_MODEL=claude-opus-5-5
# 사고 깊이. 첨삭은 짧은 작업이므로 medium부터 시작해 실측으로 조정한다.
LLM_EFFORT=medium
PROMPT_VERSION=rewrite-v3
# 요청당 예산 (project-design §5.3 초안)
MAX_DRAFT_CHARS=2000
MAX_OUTPUT_TOKENS=4000
REQUEST_TIMEOUT_SECONDS=20
# 사용량 제어: 사용자·하루(한국 시간) 한도. 넘으면 429. GET /v1/usage 로 확인
USAGE_DAILY_REWRITE_LIMIT=200
USAGE_DAILY_TOKEN_LIMIT=400000
# 인증: 세션 쿠키(pi_session, HttpOnly) + X-CSRF-Token. 헤더 스텁(X-User-Id)은 개발용 — 배포에서는 false
# 비브라우저 클라이언트(모바일·PC 프로그램)는 POST /v1/auth/token 으로 받은 토큰을 Authorization: Bearer 로 보낸다.
AUTH_ALLOW_HEADER_STUB=true
AUTH_ALLOW_REGISTER=true
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15

# ---- 배포·운영 (아래 값은 개발 기본값. 운영 값은 .env.production.example, 절차는 docs/deploy.md) ----
# production이면 서버 시작 때 위험한 설정을 거부하고(/docs·/redoc·/openapi.json도 끈다) 로그에 이유를 적는다.
#   거부: AUTH_ALLOW_HEADER_STUB=true, SESSION_COOKIE_SECURE=false, DATABASE_URL 비었음,
#         DB·Neo4j 비밀번호가 이 파일의 개발 기본값(persona-dev-only, neo4j-dev-only)
#   경고: LLM_PROVIDER=fake, ADMIN_USERNAMES·TRUSTED_HOSTS 비었음, 가입이 열렸는데 초대 코드 없음, 요청 제한 0
APP_ENV=development
# 앱 로그 수준 (DEBUG·INFO·WARNING·ERROR). 접근 로그는 메서드·경로·상태·ms·요청 id만 남긴다(쿼리·본문·쿠키 없음).
LOG_LEVEL=INFO
# 다른 출처의 화면이 API를 부를 때만 적는다(쉼표 구분). 같은 출처 화면만 쓰면 비운다 → CORS 미들웨어 없음.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# Host 헤더 허용 목록(쉼표 구분, 포트 없이. 예: persona.example.com,*.example.com). 비면 검사하지 않는다.
# /healthz 는 이 검사를 받지 않는다 (컨테이너·프록시 헬스체크).
TRUSTED_HOSTS=
# 가입 제어. 초대 코드를 적으면 가입 요청에 같은 값(invite_code)이 있어야 한다(틀리면 403 invalid_invite).
REGISTER_INVITE_CODE=
# true면 가입 요청에 consent=true가 있어야 한다(없으면 422 consent_required). 동의 시각·버전을 users에 기록한다.
REQUIRE_CONSENT=false
# 약관·개인정보 안내의 버전. 바꾸면 기존 사용자의 consent_current가 false가 되어 화면이 다시 동의를 받는다.
CONSENT_VERSION=2026-11-11
# 관리자 이름(쉼표 구분, 대소문자 무시). 이 이름으로 가입한 계정이 /admin 과 /v1/admin/* 에 들어간다.
# 운영에서는 서비스를 알리기 전에 먼저 만들어 둔다: scripts/reset_password.py --username <이름> --create
ADMIN_USERNAMES=
# 요청 제한 (IP당 분당 요청 수, 0=끔). 프로세스 메모리에 세므로 워커 1개로 띄운다.
#   RATE_LIMIT_PER_MINUTE      /v1/* 전체
#   RATE_LIMIT_AUTH_PER_MINUTE 로그인·가입·토큰 발급·비밀번호 변경·계정 삭제 (위 한도에 더해서)
# 넘으면 429 rate_limited + Retry-After. 프록시 뒤에서는 uvicorn --proxy-headers 로 실제 IP를 받는다.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_AUTH_PER_MINUTE=0
# 요청 본문 상한(바이트). 넘으면 413 payload_too_large. 한글은 글자당 3바이트라 MAX_IMPORT_CHARS(200만 자)보다 넉넉한 8MB.
MAX_BODY_BYTES=8000000
# 서버 안에서 정리 작업(만료 세션·오래된 작업·사용량 카운터)을 도는 주기(시간). 0=끔(cron으로 scripts/housekeeping.py).
HOUSEKEEPING_INTERVAL_HOURS=0
# 첨삭 이력 보존 일수. 지나면 정리 작업이 지운다. 0=무기한
REWRITE_RETENTION_DAYS=0
# 전체 사용자 합계 하루 차단기(사용량 날짜 기준). 닿으면 첨삭이 429 budget_exceeded. 0=끔
USAGE_GLOBAL_DAILY_REWRITE_LIMIT=0
USAGE_GLOBAL_DAILY_TOKEN_LIMIT=0
# 대화 가져오기: 원문 파싱(parse/raw) 본문 글자 수 상한, API로 들어온 대화의 전화번호·이메일 등 가림
MAX_IMPORT_CHARS=2000000
IMPORT_MASK_PII=true
# 그래프 수집 비용 상한 (메시지 1건 = haiku 호출 1건). 사용자당 누적 / 하루 전체. 0=무제한
GRAPH_INGEST_USER_MESSAGE_CAP=0
GRAPH_INGEST_DAILY_GLOBAL_CAP=0
# 관리자 화면의 비용 환산 단가(USD). 0이면 환산하지 않는다 — Console 요금표의 값으로 채운다.
COST_REWRITE_INPUT_PER_MTOK=0
COST_REWRITE_OUTPUT_PER_MTOK=0
COST_GRAPH_PER_EPISODE=0

# ---- PostgreSQL + pgvector (2주차 C 경로) ----
POSTGRES_USER=persona
POSTGRES_PASSWORD=persona-dev-only
POSTGRES_DB=persona_ize
DATABASE_URL=postgresql+asyncpg://persona:persona-dev-only@localhost:5432/persona_ize
# 임베딩: Anthropic은 임베딩 API가 없어 로컬 오픈 모델을 기본으로 한다 (docs/decisions.md 2026-11-08).
# local=sentence-transformers(첫 실행에 모델 다운로드) / fake=테스트용 해시 벡터(의미 없음)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ---- Neo4j 로컬 컨테이너 (3주차 D 경로, graph/graphiti_p0) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j-dev-only
# 그래프 추출 모델. 5.5 계열은 graphiti의 강제 tool_choice가 400이라 4.5 Haiku로 시작한다 (decisions 11-04).
GRAPH_LLM_MODEL=claude-haiku-4-5
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=4
GROUP_ID=p0-sample
