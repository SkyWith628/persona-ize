# 비밀정보 (.env.production도 여기에 걸린다 — 예시 파일 두 개만 커밋)
.env
.env.*
!.env.example
!.env.production.example

# 운영 산출물: DB 덤프(대화 원문이 들어 있다), 배포 기록
backups/
.deploy/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# 실험 결과 (CSV 요약만 커밋, 원시 로그는 제외)
runs/
evals/results/*.jsonl

# 평가 사례의 빈 틀 (evals/coverage.py --template 이 만든다. 번호가 금방 낡는다)
evals/eval_cases.todo.csv

# Node (apps/web)
node_modules/
apps/web/dist/

# OS / 편집기
.DS_Store
Thumbs.db
.idea/
.vscode/

# 블라인드 평가 정답 키 (채점 끝날 때까지 비공개)
evals/blind/*-key.csv

# Xcode 사용자별 상태
xcuserdata/
