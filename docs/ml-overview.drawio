        <mxCell id="e4" value="&lt;b&gt;검색&lt;/b&gt;&lt;br&gt;C: 비슷한 내 발화 묶음&lt;br&gt;D: + 그래프의 관련 사실" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="572" y="880" width="142" height="84" as="geometry"/></mxCell>
