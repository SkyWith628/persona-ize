  <diagram id="svc" name="1. 서비스 구조와 학습 모델이 붙는 자리">
    <mxGraphModel dx="1800" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
