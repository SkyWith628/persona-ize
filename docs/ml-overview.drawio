        <mxCell id="mlhe17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7891566265060241;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m6" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mlhe18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9337349397590361;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m7" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="h1" value="&lt;b&gt;0단계 · 실제 첨삭 결과&lt;/b&gt;&lt;br&gt;100~200건" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="h2" value="&lt;b&gt;사람이 읽는다&lt;/b&gt;&lt;br&gt;규칙이 통과시켰지만&lt;br&gt;뜻이 달라진 것을 센다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="600" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;시험 세트 B&lt;/b&gt;&lt;br&gt;실제 위반 · 실제 정상" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;spacingTop=10;fillColor=#E3F2FD;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="595" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="k2" value="&lt;b&gt;채점&lt;/b&gt;&lt;br&gt;모든 방식 · 같은 시험 세트&lt;br&gt;채점 코드는 한 벌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="k3" value="&lt;b&gt;재는 것&lt;/b&gt;&lt;br&gt;유형별 정밀도·재현율·F1 · 오탐률 1%일 때의 재현율&lt;br&gt;데이터 양에 따른 점수 · 세트 A와 B의 차이&lt;br&gt;CPU 지연" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="600" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="k4" value="&lt;b&gt;비교표 · 결과 파일&lt;/b&gt;&lt;br&gt;설정 · 데이터 버전 · 코드 버전을&lt;br&gt;함께 적는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="k5" value="&lt;b&gt;서비스에 붙이기&lt;/b&gt;&lt;br&gt;기본은 꺼짐&lt;br&gt;처음에는 경고만" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1540" y="600" width="170" height="80" as="geometry"/></mxCell>
