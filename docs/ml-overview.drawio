        <mxCell id="e2" value="&lt;b&gt;조건 고르기&lt;/b&gt;&lt;br&gt;A 초안만 / B +설정&lt;br&gt;C +말투 예시&lt;br&gt;D +과거 맥락" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="224" y="880" width="142" height="84" as="geometry"/></mxCell>
