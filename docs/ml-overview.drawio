        <mxCell id="LA" value="사용하는 곳과 입구" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=24;fontStyle=1;fontSize=13;arcSize=3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1760" height="110" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;PC 웹 앱 (브라우저)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="46" width="230" height="30" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;아이폰 앱 · 보조 키보드&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="88" width="230" height="30" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;API 입구&lt;/b&gt;&lt;br&gt;로그인 확인 · 요청 횟수 제한 · 본문 크기 제한" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;하루 사용량 한도&lt;/b&gt;&lt;br&gt;사용자별 · 넘으면 그날은 거절" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="55" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;관리자 화면&lt;/b&gt;&lt;br&gt;숫자만 본다 (대화 문장은 안 보임)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="55" width="250" height="56" as="geometry"/></mxCell>
        <mxCell id="an" value="가져오기(①)와 첨삭(③) 요청은 모두 이 입구를 지나 아래로 들어간다." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#444444;whiteSpace=wrap;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="55" width="420" height="56" as="geometry"/></mxCell>
