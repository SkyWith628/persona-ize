        <mxCell id="L3" value="③ 평가와 보고" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=24;fontStyle=1;fontSize=13;arcSize=3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1760" height="240" as="geometry"/></mxCell>
        <mxCell id="k1" value="&lt;b&gt;같은 모양으로 감싸기&lt;/b&gt;&lt;br&gt;어떤 방식이든 문장(쌍)을 받아 라벨과 점수를 돌려준다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="505" width="1660" height="44" as="geometry"/></mxCell>
        <mxCell id="mlhe12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.06626506024096386;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
