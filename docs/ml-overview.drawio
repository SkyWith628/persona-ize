        <mxCell id="1" parent="0"/>
        <mxCell id="L1" value="① 데이터 — 학습용과 시험용은 섞지 않는다" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=24;fontStyle=1;fontSize=13;arcSize=3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1760" height="240" as="geometry"/></mxCell>
        <mxCell id="g1" value="&lt;b&gt;합성 초안 만들기&lt;/b&gt;&lt;br&gt;상대 · 상황 · 의도를 골고루&lt;br&gt;(Claude)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="g2" value="&lt;b&gt;충실하게 고쳐 쓰기&lt;/b&gt;&lt;br&gt;→ '보존' 예시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="g3" value="&lt;b&gt;일부러 한 군데 망가뜨리기&lt;/b&gt;&lt;br&gt;→ '위반' 예시&lt;br&gt;망가뜨린 유형이 곧 정답" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="g4" value="&lt;b&gt;정답 붙이기&lt;/b&gt;&lt;br&gt;위반 유형 · 말투 · 의도&lt;br&gt;약속·불가·부정 여부" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="g5" value="&lt;b&gt;나누기&lt;/b&gt;&lt;br&gt;한 번 나누면 고정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;학습 세트&lt;/b&gt;&lt;br&gt;수천~1만 쌍" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;spacingTop=10;fillColor=#E3F2FD;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="53" width="150" height="84" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;시험 세트 A&lt;/b&gt;&lt;br&gt;사람이 확인한 300쌍쯤" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;spacingTop=10;fillColor=#E3F2FD;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="53" width="160" height="84" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;채팅 말뭉치&lt;/b&gt;&lt;br&gt;정답 없는 채팅 문장" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;spacingTop=10;fillColor=#E3F2FD;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="160" height="85" as="geometry"/></mxCell>
        <mxCell id="gn" value="망가뜨리는 유형: 요일·숫자 바꾸기 / '안'을 빼서 부정 뒤집기 / 약속을 '알겠습니다'로 약하게 / 없던 사유 덧붙이기.&lt;br&gt;실제 카카오톡 대화를 쓸 때는 대화도, 그것으로 학습한 모델 파일도 밖에 올리지 않는다." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#444444;whiteSpace=wrap;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="1000" height="60" as="geometry"/></mxCell>
        <mxCell id="mlhe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mlhe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mlhe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mlhe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mlhe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="g5" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mlhe6" value="학습에 쓰지 않는다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="36"/><mxPoint x="1640" y="36"/></Array></mxGeometry></mxCell>
        <mxCell id="L2" value="② 견주는 방식 일곱 가지 — 같은 문제를 여러 방식이 푼다" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=24;fontStyle=1;fontSize=13;arcSize=3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1760" height="170" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;1. 지금의 규칙&lt;/b&gt;&lt;br&gt;사람이 적은 정규식&lt;br&gt;기준선" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;2. 임베딩 + 가벼운 분류기&lt;/b&gt;&lt;br&gt;지금 쓰는 임베딩 위에&lt;br&gt;작은 분류기 · 노트북에서 몇 초" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;3. 공개 추론 모델 그대로&lt;/b&gt;&lt;br&gt;학습 없이 가져다 씀&lt;br&gt;우리 데이터 없이 얻는 수준" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;4. 미세조정 (판정별로 따로)&lt;/b&gt;&lt;br&gt;공개 한국어 모델을&lt;br&gt;우리 문제로 더 가르침 · GPU" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m5" value="&lt;b&gt;5. 미세조정 (네 판정을 한 모델로)&lt;/b&gt;&lt;br&gt;모델 하나로 충분한가 · GPU" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m6" value="&lt;b&gt;6. Claude에게 묻기&lt;/b&gt;&lt;br&gt;예시 없이 / 예시 몇 개와 함께 (ICL)&lt;br&gt;상한선과 그 비용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m7" value="&lt;b&gt;7. 채팅 말투 적응 뒤 미세조정&lt;/b&gt;&lt;br&gt;채팅 문장을 더 읽힌 뒤 4·5번&lt;br&gt;(도메인 적응) · GPU" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="330" width="220" height="90" as="geometry"/></mxCell>
