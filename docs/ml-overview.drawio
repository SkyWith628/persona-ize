        <mxCell id="LB" value="① 대화 가져오기" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=24;fontStyle=1;fontSize=13;arcSize=3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="1760" height="250" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;대화 파일&lt;/b&gt;&lt;br&gt;카카오톡 · 텔레그램&lt;br&gt;붙여넣기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;형식 알아내기 · 읽기&lt;/b&gt;&lt;br&gt;못 읽은 줄은&lt;br&gt;미리보기에 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="190" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;개인정보 가림&lt;/b&gt;&lt;br&gt;전화번호·이메일 같은 패턴&lt;br&gt;(이름·주소는 못 가림)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="190" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;화자 지정 · 중복 확인&lt;/b&gt;&lt;br&gt;누가 '나'인지&lt;br&gt;같은 파일은 건너뜀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;메시지 저장&lt;/b&gt;&lt;br&gt;여기까지는&lt;br&gt;요청 안에서 끝냄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;문체 묶음 만들기&lt;/b&gt;&lt;br&gt;내 연속 발화 6건·600자씩&lt;br&gt;+ 바로 앞 맥락" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="190" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b&gt;임베딩&lt;/b&gt;&lt;br&gt;묶음을 숫자 384개로 (e5-small)&lt;br&gt;응답 뒤에 이어서 돎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="190" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b&gt;수집 전 거르기&lt;/b&gt;&lt;br&gt;그래프에 넣을 사실이 있는&lt;br&gt;메시지인가" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="165" height="70" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b&gt;그래프 수집&lt;/b&gt;&lt;br&gt;시간 순으로 한 건씩 · 메시지당&lt;br&gt;모델 8~9회 · 3번 실패하면 보류" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#333333;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1165" y="300" width="180" height="70" as="geometry"/></mxCell>
