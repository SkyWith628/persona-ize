        <mxCell id="mlhe10" value="학습 세트" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="m7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1175" y="300"/><mxPoint x="1556" y="300"/></Array></mxGeometry></mxCell>
