# 배포용 설정 예시. 서버에서 .env.prod로 복사해 채운다. .env.prod는 커밋하지 않는다.
# 채운 뒤 점검: python scripts/check_prod_env.py .env.prod

# ---- 주소 ----
# 프록시가 인증서를 받을 도메인. 도메인이 없으면 <서버 공인 IP를 -로 이은 값>.sslip.io (예: 3-35-1-2.sslip.io)
SITE_ADDRESS=

# ---- 모델 ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
PROMPT_VERSION=rewrite-v3
MAX_DRAFT_CHARS=2000
MAX_OUTPUT_TOKENS=4000
REQUEST_TIMEOUT_SECONDS=20
GRAPH_LLM_MODEL=claude-haiku-4-5
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=4

# ---- 사용량 한도 (사용자·하루) ----
USAGE_DAILY_REWRITE_LIMIT=50
USAGE_DAILY_TOKEN_LIMIT=150000

# ---- 인증: 배포에서는 아래 두 줄을 바꾸지 않는다 ----
AUTH_ALLOW_HEADER_STUB=false
SESSION_COOKIE_SECURE=true
# 가입(아이디·이메일·소셜 신규). false면 계정은 서버에서 직접 만든다 (docs/deploy.md, create_user).
# true로 열 때는 아래 승인제를 반드시 true로 둔다 — 아니면 누구나 가입해 API 비용을 쓴다 (점검 스크립트가 막는다).
AUTH_ALLOW_REGISTER=false
# 새 계정은 승인 대기(pending). 관리자가 /admin 회원관리에서 승인해야 첨삭 등 API를 쓸 수 있다.
AUTH_SIGNUP_REQUIRES_APPROVAL=true
SESSION_TTL_DAYS=14
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
# 운영 대시보드·회원관리(/admin)를 볼 아이디, 쉼표 구분 (초기 관리자). 이 이름은 공개 가입으로 만들 수 없다.
ADMIN_USERNAMES=

# ---- 소셜 로그인 (비우면 꺼진다) ----
# 제공자 콘솔에 등록할 Redirect URI: {PUBLIC_BASE_URL}/v1/auth/oauth/google/callback, .../kakao/callback
# PUBLIC_BASE_URL은 https://도메인 (끝에 / 없이). 제공자 ID를 넣었으면 반드시 채운다.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오 REST API 키. 시크릿은 콘솔에서 "클라이언트 시크릿"을 켰을 때만 넣는다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---- DB: 비밀번호는 새로 만든 긴 무작위 값 (예: openssl rand -hex 24) ----
POSTGRES_USER=persona
POSTGRES_PASSWORD=
POSTGRES_DB=persona_ize
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
