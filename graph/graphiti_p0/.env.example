# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 저장소 루트의 .env를 그대로 써도 된다 (같은 변수명).

# Neo4j: 기본은 로컬 Docker (docker compose up). Aura를 쓰면 접속 파일의 값을 넣는다.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j-dev-only

# Claude. 비우면 anthropic SDK가 ANTHROPIC_API_KEY 환경변수 / `ant auth login` 프로필을 읽는다.
ANTHROPIC_API_KEY=
# 그래프 추출은 에피소드마다 LLM을 여러 번 부르므로 저렴한 모델로 시작해 품질을 본다.
GRAPH_LLM_MODEL=claude-haiku-5-5

# 임베딩: local(sentence-transformers, 키 불필요) | voyage(VOYAGE_API_KEY 필요)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
VOYAGE_API_KEY=

# 실험 단위로 데이터를 분리한다.
GROUP_ID=p0-sample

# Graphiti 내부 병렬 LLM 호출 수. 429가 나면 낮춘다.
SEMAPHORE_LIMIT=4
GRAPHITI_TELEMETRY_ENABLED=false
