# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 커밋하지 않는다.

# Neo4j Aura 인스턴스 생성 시 내려받는 접속 파일의 값을 그대로 쓴다.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Anthropic 콘솔(console.anthropic.com)에서 월 사용 한도를 먼저 건다.
ANTHROPIC_API_KEY=
# Voyage AI(dash.voyageai.com)에서 발급. 임베딩 전용.
VOYAGE_API_KEY=

# 비우면 claude-haiku-4-5. 5.5 계열(Opus/Sonnet)은 graphiti의 강제 tool_choice가 400이라 검증 전 사용 금지.
LLM_MODEL=
LLM_SMALL_MODEL=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024

# 실험 단위로 데이터를 분리한다. 같은 Aura 인스턴스에서 여러 실험을 돌릴 때 바꾼다.
GROUP_ID=p0-sample

# Graphiti 내부 병렬 LLM 호출 수. 429(요청 한도) 오류가 나면 낮춘다.
SEMAPHORE_LIMIT=4
# Graphiti 익명 사용 통계 전송 끄기
GRAPHITI_TELEMETRY_ENABLED=false
