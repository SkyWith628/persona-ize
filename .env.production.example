# Persona_ize 운영 설정 예시. 서버에서 복사해 값을 채운다 — 따라 하는 순서는 docs/deploy.md.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# - .env.production 은 커밋하지 않는다(.gitignore). 비밀 값이 들어 있다.
# - CHANGE_ME 가 남아 있으면 scripts/ops/deploy.sh 가 배포를 멈춘다.
# - 비밀 값 만들기:  openssl rand -base64 32 | tr -d '/+='
#   (DB 비밀번호는 접속 주소(URL) 안에 들어가므로 / + = @ : 같은 기호가 없는 값이 안전하다)
# - 값 뒤에 주석을 붙이지 않는다(`KEY=값 # 설명` 금지 — 주석까지 값으로 읽힐 수 있다). 설명은 윗줄에.
# - 이 파일은 두 곳에서 읽는다: docker compose(${...} 치환)와 backend 컨테이너(환경변수).

# =====================================================================
# 1. 주소·인증서 (Caddy)
# =====================================================================
# 서비스 도메인. DNS A 레코드가 이 서버를 가리키면 Caddy가 Let's Encrypt 인증서를 자동으로 받는다.
# 도메인 없이 띄울 때의 선택지와 제약은 docs/deploy.md "도메인 없이 띄우기".
SITE_ADDRESS=persona.example.com
# 인증서 발급 계정의 연락처(선택). 비워도 발급된다.
ACME_EMAIL=
# 밖으로 여는 포트. 바꾸는 것은 로컬 검증용이다 — 운영은 80/443 그대로 둔다
# (포트를 바꾸면 Let's Encrypt 확인이 안 되고, http→https 리다이렉트도 443을 가리킨다).
HTTP_PORT=80
HTTPS_PORT=443
# HSTS 유지 시간(초). 처음 며칠은 300처럼 짧게 두고 https가 안정된 뒤 31536000(1년)으로 올린다.
HSTS_MAX_AGE=300
# 백엔드 이미지 이름. 서버에서 직접 빌드하면 그대로 둔다. 레지스트리에서 받아 쓰려면 그 주소로 바꾸고
# `deploy.sh --no-build` (예: ghcr.io/<소유자>/<저장소>/backend:v0.1.0).
BACKEND_IMAGE=persona-ize/backend:prod

# =====================================================================
# 2. 운영 모드·보안
# =====================================================================
# production이면 서버가 시작할 때 위험한 설정(헤더 스텁 켜짐, 쿠키 Secure 꺼짐, 개발용 기본 비밀번호,
# DATABASE_URL 빔)을 거부하고 /docs를 끈다. 운영에서는 바꾸지 않는다.
APP_ENV=production
LOG_LEVEL=INFO
# 개발용 인증 우회(X-User-Id 헤더). 운영에서는 반드시 false.
AUTH_ALLOW_HEADER_STUB=false
# 세션 쿠키를 https에서만 보낸다. 운영에서는 반드시 true(그래서 https 없이는 로그인이 유지되지 않는다).
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=14
# 로그인 실패 제한: 같은 곳(IP)에서 같은 아이디를 이 횟수만큼 틀리면 그 조합만 그 시간(분) 동안 429.
# IP 하나의 실패 합계는 한도 × AUTH_IP_FAILURE_FACTOR(5×6=30번)에서 그 IP의 모든 로그인을,
# 아이디 하나의 실패 합계는 한도 × AUTH_NAME_FAILURE_FACTOR(5×4=20번)에서 그 계정의 모든 로그인을 막는다.
# 많은 사람이 한 IP로 나오는 곳(학교·회사)에서 쓰면 IP 배수를 올리거나 0(그 범위 끔)으로 둔다.
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
AUTH_IP_FAILURE_FACTOR=6
AUTH_NAME_FAILURE_FACTOR=4
# 다른 출처(도메인)의 화면이 API를 부를 때만 적는다(쉼표 구분). 비우면 같은 출처만 — 운영 기본.
CORS_ALLOW_ORIGINS=
# Host 허용 목록(쉼표 구분). 비워 두면 compose가 SITE_ADDRESS를 넣는다.
TRUSTED_HOSTS=
# IP당 분당 요청 수 제한. 0이면 끈다. 앞은 /v1 전체, 뒤는 로그인·가입·토큰 발급.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
# 요청 본문 상한(바이트). Caddy도 같은 값으로 막는다.
MAX_BODY_BYTES=8000000
# 프록시가 넘긴 클라이언트 IP(X-Forwarded-For)를 믿을 주소. backend 포트는 밖에 열려 있지 않아 기본 * 로 둔다.
FORWARDED_ALLOW_IPS=*

# =====================================================================
# 3. 가입·관리자
# =====================================================================
AUTH_ALLOW_REGISTER=true
# 값이 있으면 가입할 때 이 코드를 요구한다. 비워 두면 주소를 아는 누구나 가입해 API 비용을 쓸 수 있다.
# 예) openssl rand -hex 6
REGISTER_INVITE_CODE=CHANGE_ME_invite_code
# 가입할 때 약관·개인정보 안내 동의를 요구한다. 안내문을 고치면 CONSENT_VERSION을 올린다(다시 동의받는다).
REQUIRE_CONSENT=true
CONSENT_VERSION=2026-11-11
# 관리자 아이디(쉼표 구분). 이 이름으로 로그인한 사람만 /admin 화면과 /v1/admin/* 을 본다.
# 이름은 대소문자까지 같아야 한다. 운영(APP_ENV=production)에서는 이 이름을 화면 가입으로 만들 수 없다(선점 방지) —
# 서버에서 `scripts/ops/run.sh scripts/reset_password.py --username <이름> --create`로 만든다(docs/deploy.md 7단계).
ADMIN_USERNAMES=CHANGE_ME_admin_id

# =====================================================================
# 4. 모델(Claude)과 비용 상한
# =====================================================================
# anthropic: Claude API 실제 호출. fake: 원문을 그대로 돌려주는 가짜 모델(배포 연습·화면 확인용, 비용 0).
LLM_PROVIDER=anthropic
# Console(https://console.anthropic.com)에서 만든 키. 먼저 Console에서 월 사용량 한도를 건다 — 최후의 상한이다.
ANTHROPIC_API_KEY=CHANGE_ME_anthropic_api_key
# 첨삭 모델(claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5)과 사고 깊이(low·medium·high).
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
PROMPT_VERSION=rewrite-v3
# 요청 하나의 크기·시간 제한.
MAX_DRAFT_CHARS=2000
MAX_OUTPUT_TOKENS=4000
REQUEST_TIMEOUT_SECONDS=20

# 사용자 한 명의 하루(한국 시간) 한도. 넘으면 그 사용자만 429.
USAGE_DAILY_REWRITE_LIMIT=200
USAGE_DAILY_TOKEN_LIMIT=400000
# 전체 사용자 합계의 하루 차단기. 0이면 끈다(끄면 상한이 "사용자 한도 × 사용자 수"가 된다).
# 아래는 예시 값이다 — 하루 최악 비용 = 토큰 한도 × Console 요금표의 토큰 단가로 계산해 예산에 맞춘다.
USAGE_GLOBAL_DAILY_REWRITE_LIMIT=2000
USAGE_GLOBAL_DAILY_TOKEN_LIMIT=4000000

# 그래프 수집 상한(메시지 1건 = haiku 호출 1번 이상). 11월 실측에서 메시지당 약 US$0.03~0.04였고
# 전체 비용의 85%가 여기서 나왔다. 0이면 무제한 — 운영에서는 반드시 건다.
#   USER_MESSAGE_CAP: 사용자 한 명이 그래프에 넣을 수 있는 메시지 총수
#   DAILY_GLOBAL_CAP: 하루에 전체가 넣을 수 있는 메시지 수 (1000건이면 하루 최악 약 US$30~40)
# 상한에 닿아도 말투 검색(C)은 전부 동작하고, 그래프(D)에 들어가는 대화만 줄어든다.
GRAPH_INGEST_USER_MESSAGE_CAP=300
GRAPH_INGEST_DAILY_GLOBAL_CAP=1000
# 운영 모드는 비용에 전체 상한이 없는 구성(그래프 하루 상한 0, 또는 초대 코드 없는 공개 가입 + 전체 차단기 0)에서
# 시작을 거부한다. 알고도 그렇게 띄울 때만 true로 둔다(거부 대신 경고).
ALLOW_UNCAPPED_COSTS=false
# 그래프 추출 모델. 5.5 계열은 graphiti의 강제 tool_choice를 400으로 거부해 4.5 Haiku를 쓴다.
GRAPH_LLM_MODEL=claude-haiku-4-5
# 서버가 시작할 때 수집하다 만 메시지를 이어서 넣는다.
GRAPH_RESUME_ON_START=true
# 메시지 하나를 그래프에 넣다 실패해도 되는 횟수(일시 장애는 세지 않는다). 넘으면 그 메시지는 보류하고 다음으로
# 넘어간다 — 늘 실패하는 메시지가 이어받을 때마다 비용을 쓰지 않게. 보류는 scripts/graph_reset.py로 푼다. 0=제한 없음
GRAPH_EPISODE_MAX_ATTEMPTS=3
# 종료·배포 때 뒤에서 도는 묶음 생성·그래프 수집을 기다리는 시간(초). 넘으면 끊고 다음 시작 때 이어받는다.
# docker-compose.prod.yml의 backend stop_grace_period(30초)보다 10초쯤 짧게 둔다
SHUTDOWN_GRACE_SECONDS=15
# graphiti가 한 번에 보내는 요청 수와 익명 사용 통계 전송.
SEMAPHORE_LIMIT=4
GRAPHITI_TELEMETRY_ENABLED=false

# 관리자 화면의 비용 환산 단가(USD). 0이면 환산하지 않는다. 값은 Console 요금표에서 지금 쓰는 모델의
# 단가를 확인해 직접 채운다(입력·출력 100만 토큰당, 그래프는 메시지 1건당 실측 평균).
# 2026-11-11 기준: claude-opus-5-5 입력 $4 / 출력 $20 (100만 토큰당). LLM_MODEL을 바꾸면 함께 고친다
# (sonnet-5-5 2/10). 그래프는 haiku-4-5 실측 $0.03~0.04/건의 가운데 값(decisions 11-10).
COST_REWRITE_INPUT_PER_MTOK=4
COST_REWRITE_OUTPUT_PER_MTOK=20
COST_GRAPH_PER_EPISODE=0.035

# =====================================================================
# 5. 가져오기·보존
# =====================================================================
# 원문 가져오기 한 번의 글자 수 상한. 한글은 UTF-8로 글자당 3바이트라 200만 자가 약 6MB다 — MAX_BODY_BYTES(8MB) 안에 든다.
MAX_IMPORT_CHARS=2000000
# 한 번에 가져오는 메시지 수 상한. 임베딩은 응답 뒤에 서버 안에서 이어지지만(메시지 2,000건이 수십 초~몇 분,
# 서버 사양에 따라 다르다) 그동안 CPU를 쓰므로 작은 서버에서는 낮게 둔다. 넘으면 화면이 "최근 N건만"을 권한다.
MAX_IMPORT_MESSAGES=2000
# 사용자별 저장 한도 (넘으면 422 quota_exceeded)
MAX_CONTACTS_PER_USER=200
MAX_CONVERSATIONS_PER_USER=500
MAX_MESSAGES_PER_USER=50000
# 가져온 대화에서 전화번호·이메일·주민등록번호·카드/계좌 번호 모양을 가리고 저장한다.
IMPORT_MASK_PII=true
# 서버 안에서 정리 작업(만료 세션, 오래된 작업 기록, 보존 기간 지난 첨삭 이력)을 도는 주기(시간). 0이면 끈다.
HOUSEKEEPING_INTERVAL_HOURS=24
# 첨삭 이력 보존 일수(지나면 주기 정리 때 지운다). 0이면 사용자가 지울 때까지 둔다. 설계 원칙은 "오래 두지 않는다"라
# 예시는 90일이다. 화면의 "내 데이터"가 이 값을 보여 주고, 개인정보 안내문(/privacy)의 설명과 어긋나지 않게 한다.
REWRITE_RETENTION_DAYS=90
# 그 밖의 조정 값(기본값 그대로 두면 된다. 바꿀 때만 주석을 푼다)
# MAX_IMPORT_MESSAGES=5000
# 가져오기 요청이 말투 묶음 생성을 기다리는 초. 넘으면 processing으로 답하고 뒤에서 끝낸다(프록시 시간 제한보다 짧게)
# IMPORT_INDEX_WAIT_SECONDS=2
# MAX_SITUATION_CHARS=500
# RETRIEVAL_TOP_K=4
# GRAPH_SEARCH_TOP_K=4
# USAGE_DAY_OFFSET_HOURS=9

# =====================================================================
# 6. PostgreSQL
# =====================================================================
POSTGRES_USER=persona
# 데이터 볼륨이 처음 만들어질 때만 적용된다. 나중에 여기만 바꾸면 접속이 깨진다(docs/deploy.md "비밀번호 바꾸기").
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=persona_ize
# DATABASE_URL 은 적지 않는다 — compose가 위 세 값으로 조립해 backend에 넣는다. 여기 적어도 compose 값이 이긴다.
# DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>

# 임베딩: 로컬 e5-small. 모델은 이미지에 들어 있어 내려받지 않는다. 모델을 바꾸려면 이미지를 다시 만들고
# (--build-arg EMBEDDING_MODEL=...) 벡터 차원이 달라지면 마이그레이션과 재색인이 필요하다.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# =====================================================================
# 7. Neo4j (그래프, D 조건)
# =====================================================================
# 8자 이상. 데이터 볼륨이 처음 만들어질 때만 적용된다. 사용자 이름은 neo4j 고정이다(커뮤니티판).
NEO4J_PASSWORD=CHANGE_ME_neo4j_password
# 아래 둘은 compose가 넣는다 — 여기 적지 않는다(적어도 compose 값이 이긴다).
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# 메모리(작은 VM 기준). 그래프가 커져 느려지면 pagecache부터 늘린다.
NEO4J_HEAP_SIZE=512m
NEO4J_PAGECACHE_SIZE=256m

# =====================================================================
# 8. 백업·자원
# =====================================================================
# backup 컨테이너가 이 주기(시간)로 pg_dump를 뜨고, 보존 일수가 지난 파일을 지운다. 주기 0이면 끈다.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# 덤프를 두는 서버의 폴더(compose 파일 기준 상대 경로 또는 절대 경로).
BACKUP_DIR=./backups
# 컨테이너 메모리 상한. 넘으면 그 컨테이너만 죽었다가 다시 뜬다(서버 전체가 멈추는 것을 막는다).
BACKEND_MEM_LIMIT=2g
NEO4J_MEM_LIMIT=2g
# backend 컨테이너의 파일시스템을 읽기 전용으로 둔다(/tmp만 쓰기 가능). 파일 쓰기 오류가 나면 false로 풀어 본다.
BACKEND_READ_ONLY=true
